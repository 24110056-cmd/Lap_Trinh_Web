<sitemesh>
    <content-processor>
        <tag-rule-bundle class="org.sitemesh.content.tagrules.html.Sm2TagRuleBundle"/>
    </content-processor>

    <mapping path="/login*" exclude="true"/>
    <mapping path="/register*" exclude="true"/>
    <mapping path="/forgot*" exclude="true"/>
    <mapping path="/verify*" exclude="true"/>
    <mapping path="/profile/verify-email" exclude="true"/>

    <mapping path="/image*" exclude="true"/>
    <mapping path="/download*" exclude="true"/>

    <mapping path="/assets*" exclude="true"/>
    <mapping path="/css*" exclude="true"/>
    <mapping path="/js*" exclude="true"/>
    <mapping path="/images*" exclude="true"/>

    <mapping path="/admin/*" decorator="/WEB-INF/decorators/admin.jsp"/>
    <mapping path="/*" decorator="/WEB-INF/decorators/web.jsp"/>
</sitemesh>